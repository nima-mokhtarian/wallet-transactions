{
	"info": {
		"_postman_id": "1f06f06a-964c-4509-8591-1910c50ce9fa",
		"name": "Wallet Transactions – EVM / Bitcoin / Solana",
		"description": "Fetch all transactions for a wallet across common chains using Postman.\n\nSet environment variables before running:\n\nEVM / Etherscan-compatible:\n- etherscan_base (e.g. https://api.etherscan.io/api, https://api.bscscan.com/api, https://api.polygonscan.com/api)\n- api_key (your explorer API key)\n- address (wallet address, 0x...)\n- block_start (default 0)\n- block_end (default 99999999)\n- page (default 1)\n- offset (default 10000)\n\nBitcoin / Blockstream:\n- blockstream_base (e.g. https://blockstream.info/api)\n- btc_address\n\nSolana:\n- solana_rpc (e.g. https://api.mainnet-beta.solana.com)\n- sol_address\n- sol_limit (e.g. 1000)\n- sol_before (optional; signature string)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "34129784",
		"_collection_link": "https://abank-backend-b.postman.co/workspace/ea8e1869-5f7e-4d43-8007-57552523ed45/collection/34129784-1f06f06a-964c-4509-8591-1910c50ce9fa?action=share&source=collection_link&creator=34129784"
	},
	"item": [
		{
			"name": "EVM (Etherscan-compatible)",
			"item": [
				{
					"name": "Normal Transactions (txlist)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{etherscan_base}}?module=account&action=txlist&address={{address}}&startblock={{block_start}}&endblock={{block_end}}&page={{page}}&offset={{offset}}&sort=asc&apikey={{api_key}}",
							"host": [
								"{{etherscan_base}}"
							],
							"query": [
								{
									"key": "module",
									"value": "account"
								},
								{
									"key": "action",
									"value": "txlist"
								},
								{
									"key": "address",
									"value": "{{address}}"
								},
								{
									"key": "startblock",
									"value": "{{block_start}}"
								},
								{
									"key": "endblock",
									"value": "{{block_end}}"
								},
								{
									"key": "page",
									"value": "{{page}}"
								},
								{
									"key": "offset",
									"value": "{{offset}}"
								},
								{
									"key": "sort",
									"value": "asc"
								},
								{
									"key": "apikey",
									"value": "{{api_key}}"
								}
							]
						},
						"description": "Normal Transactions (txlist) via Etherscan-style API. Change {etherscan_base} per chain."
					},
					"response": []
				},
