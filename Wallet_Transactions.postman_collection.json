		{
			"name": "Bitcoin (Blockstream Electrs API)",
			"item": [
				{
					"name": "Address Transactions (first page)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{blockstream_base}}/address/{{btc_address}}/txs",
							"host": [
								"{{blockstream_base}}"
							],
							"path": [
								"address",
								"{{btc_address}}",
								"txs"
							]
						},
						"description": "Gets newest transactions for the address. Use the 'Address Transactions – next page' request for pagination."
					},
					"response": []
				},
				{
					"name": "Address Transactions – next page (use last txid)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{blockstream_base}}/address/{{btc_address}}/txs/chain/:last_txid",
							"host": [
								"{{blockstream_base}}"
							],
							"path": [
								"address",
								"{{btc_address}}",
								"txs",
								"chain",
								":last_txid"
							],
							"query": [
								{
									"key": "last_txid",
									"value": "8698be0e3353cc2196cf3f7b2116d7964863f412a7bb1ad60b43c7087abb74a1",
									"disabled": true
								}
							],
							"variable": [
								{
									"key": "last_txid",
									"value": "8698be0e3353cc2196cf3f7b2116d7964863f412a7bb1ad60b43c7087abb74a1"
								}
							]
						},
						"description": "For pagination: set {{last_txid}} to the last txid from previous response."
					},
					"response": []
				},
				{
					"name": "Get Transaction Details by txid",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{blockstream_base}}/tx/:txid",
							"host": [
								"{{blockstream_base}}"
							],
							"path": [
								"tx",
								":txid"
							],
							"variable": [
								{
									"key": "txid",
									"value": "8698be0e3353cc2196cf3f7b2116d7964863f412a7bb1ad60b43c7087abb74a1"
								}
							]
						},
						"description": "Fetch full details for a transaction id."
					},
					"response": []
				}
			]
		},
		{
			"name": "Solana (JSON-RPC)",
			"item": [
				{
					"name": "getSignaturesForAddress (paged)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getSignaturesForAddress\",\n  \"params\": [\n    \"{{sol_address}}\",\n    {\n      \"limit\": \"{{sol_limit}}\",\n      \"before\": \"{{sol_before}}\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{solana_rpc}}",
							"host": [
								"{{solana_rpc}}"
							]
						},
						"description": "Returns confirmed signatures for transactions involving the given address. For pagination, set {{sol_before}} to the last signature from the previous page."
					},
					"response": []
				},
				{
					"name": "getTransaction (details)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getTransaction\",\n  \"params\": [\n    \"{{signature}}\",\n    {\n      \"encoding\": \"json\",\n      \"maxSupportedTransactionVersion\": 0\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{solana_rpc}}",
							"host": [
								"{{solana_rpc}}"
							]
						},
						"description": "Fetch full transaction by signature returned from getSignaturesForAddress."
					},
					"response": []
				}
			]
		}
	]
